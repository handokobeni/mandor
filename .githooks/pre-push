#!/bin/sh
# Menjalankan `make check` sebelum push, kecuali bila semua berkas yang akan di-push
# adalah dokumen (docs/ atau berkas Markdown), yang tidak di-build atau di-test.
cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000
code_changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # penghapusan branch
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { code_changed=1; continue; }
  else
    base=$remote_sha
  fi
  if git diff --name-only "$base" "$local_sha" | grep -qvE '^docs/|\.md$'; then
    code_changed=1
  fi
done

if [ "$code_changed" = 0 ]; then
  echo "pre-push: hanya dokumen yang berubah; make check dilewati"
  exit 0
fi
make check
